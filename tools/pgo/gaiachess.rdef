/* Haiku resources for the gaiachess binary.
 * Compiled by rc and attached with xres (see build-haiku.sh); the Deskbar and
 * Tracker read these off the executable itself, before anything of ours runs.
 * The signature must match the one BApplication is constructed with in
 * src/gui/haiku_shim.cpp.
 */

resource app_signature "application/x-vnd.GaiaChess";

resource app_version {
	major  = 4,
	middle = 2,
	minor  = 4,

	variety = B_APPV_FINAL,
	internal = 0,

	short_info = "GaiaChess",
	long_info = "GaiaChess - a chess engine with a pixel-art board"
};

/* Chess interfaces and match managers launch several engine processes at once,
 * so a single-launch flag would cost every game after the first. */
resource app_flags B_MULTIPLE_LAUNCH;
